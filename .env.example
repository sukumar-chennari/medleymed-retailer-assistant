# Ollama must be running locally (ollama serve) for the text/tool-use orchestration.
# Defaults below work out of the box once you've pulled `llama3.2` and
# `nomic-embed-text` (`ollama pull llama3.2 && ollama pull nomic-embed-text`).
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Free Gemini API key (from https://aistudio.google.com/apikey) — used only to read
# uploaded prescription/tablet photos. Without it, image uploads get a friendly
# "please type the medicine name" fallback instead of crashing.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash

# Optional — if unset, send_confirmation_email logs a [MOCK EMAIL] line instead of sending.
# Recommended: a dedicated free Gmail like medleymed.orders@gmail.com (not your personal
# email), with an App Password generated under Google Account > Security > 2-Step
# Verification > App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=MedleyMed Orders
